{
  "name": "@k18k/entrypoint",
  "version": "0.1.0",
  "description": "SDK Entrypoint: tunel z aplikacji do bramy Entrypoint (kontrakt bazowy i adapter Express)",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./express": {
      "types": "./lib/express.d.ts",
      "default": "./lib/express.js"
    }
  },
  "bin": {
    "entrypoint-tunnel": "./lib/cli.js"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "express": ">=4.18"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@k18k/entrypoint-linux-x64": "0.1.0",
    "@k18k/entrypoint-linux-arm64": "0.1.0",
    "@k18k/entrypoint-darwin-x64": "0.1.0",
    "@k18k/entrypoint-darwin-arm64": "0.1.0",
    "@k18k/entrypoint-win32-x64": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "express": "5.3.0",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
