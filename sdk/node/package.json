{
  "name": "@k18k/entrypoint-sdk",
  "version": "0.2.1",
  "description": "Entrypoint SDK: a tunnel from an application to an Entrypoint gateway (base contract, node:http, Fastify and Hono adapters)",
  "homepage": "https://github.com/k18k/entrypoint",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/entrypoint.git",
    "directory": "sdk/node"
  },
  "bin": {
    "entrypoint-tunnel": "lib/cli.js"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./http": {
      "types": "./lib/http.d.ts",
      "default": "./lib/http.js"
    },
    "./fastify": {
      "types": "./lib/fastify.d.ts",
      "default": "./lib/fastify.js"
    },
    "./hono": {
      "types": "./lib/hono.d.ts",
      "default": "./lib/hono.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run fmt:check"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@hono/node-server": ">=1.13"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@k18k/entrypoint-sdk-darwin-arm64": "0.2.1",
    "@k18k/entrypoint-sdk-darwin-x64": "0.2.1",
    "@k18k/entrypoint-sdk-linux-arm64": "0.2.1",
    "@k18k/entrypoint-sdk-linux-x64": "0.2.1",
    "@k18k/entrypoint-sdk-win32-x64": "0.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
