{
  "name": "@k18k/entrypoint-ts",
  "version": "0.1.1",
  "description": "Entrypoint SDK: a tunnel from an application to an Entrypoint gateway (base contract and node:http adapter)",
  "homepage": "https://github.com/k18k/entrypoint",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k18k/entrypoint.git",
    "directory": "sdk/node"
  },
  "bin": {
    "entrypoint-tunnel": "./lib/cli.js"
  },
  "files": [
    "lib",
    "scripts/postinstall.mjs",
    "connector.json",
    "README.md"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./http": {
      "types": "./lib/http.d.ts",
      "default": "./lib/http.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "npm run typecheck && npm run lint && npm run fmt:check",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
